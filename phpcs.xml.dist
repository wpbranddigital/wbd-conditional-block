<?xml version="1.0"?>
<ruleset name="ConditionalBlocks">
	<description>Coding standards for the ConditionalBlocks plugin.</description>

	<file>.</file>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="extensions" value="php"/>

	<rule ref="WordPress-Extra">
		<!-- The main plugin bootstrap file is conventionally named after the
		     plugin slug (conditional-blocks.php), not class-conditional-blocks.php. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="conditional-blocks"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="6.5"/>
</ruleset>
